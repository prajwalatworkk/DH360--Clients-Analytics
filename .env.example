# Copy to .env and fill in. Never commit or share this file.

# ---- Meta Ads (Marketing API) ----
# A long-lived System User token with ads_read on the client ad accounts.
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# ---- Google Ads API ----
# Developer token from your Google Ads API Center (manager account).
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth desktop-app client + a refresh token generated once (see README).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Your MCC / manager account ID, digits only, no dashes.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---- Dashboard access ----
# Required once the server is reachable beyond 127.0.0.1 (Tailscale/LAN).
DASHBOARD_PASSWORD=

# ---- Alerts ----
# Warn when a prepaid ad account's available balance falls below this. Defaults to 2000.
LOW_BALANCE_THRESHOLD=2000
